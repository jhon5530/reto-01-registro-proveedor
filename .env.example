# Proveedor del modelo: "gemini" (real) o "mock" (simulado, sin clave ni costo)
LLM_PROVIDER=gemini
# Modelo del proveedor (cambiable sin tocar código)
LLM_MODEL=gemini-3.5-flash
# Clave de Google AI Studio. SOLO en el entorno del backend. Nunca en el repo ni en el front.
GEMINI_API_KEY=
# Timeout por llamada al modelo (ms)
LLM_TIMEOUT_MS=60000
# Reintentos automáticos ante sobrecarga (503) o límite de velocidad (429)
LLM_REINTENTOS=3

# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
MAX_TURNOS_SESION=40

# Clave de acceso al link público (vacío = sin protección)
APP_ACCESS_KEY=

# Fecha de ejecución para evaluar vigencias (YYYY-MM-DD). Vacío = hoy.
FECHA_EJECUCION=

PORT=3000
